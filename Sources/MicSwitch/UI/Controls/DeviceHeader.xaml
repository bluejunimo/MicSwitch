<UserControl x:Class="MicSwitch.UI.Controls.DeviceHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:ClassModifier="internal">
    <StackPanel>
        <ui:Card Padding="16,10,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBlock Margin="0,0,0,4"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              FontTypography="Caption"
                              Text="{Binding Title}" />
                <ComboBox Grid.Row="1"
                          MinWidth="120"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{Binding Title}"
                          ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}" />
                <ProgressBar Grid.Row="2"
                             Height="3"
                             Margin="0,8,0,0"
                             AutomationProperties.Name="{Binding LevelTitle}"
                             Maximum="1"
                             Minimum="0"
                             ToolTip="{Binding LevelTitle}"
                             Value="{Binding Level, Mode=OneWay}" />

                <ui:Button Grid.Row="1"
                           Grid.Column="1"
                           Width="40"
                           Margin="8,0,0,0"
                           Padding="0"
                           VerticalAlignment="Stretch"
                           AutomationProperties.Name="{Binding MuteToolTip}"
                           Command="{Binding ToggleMuteCommand}"
                           IsEnabled="{Binding IsConnected}"
                           ToolTip="{Binding MuteToolTip}">
                    <Grid>
                        <ui:SymbolIcon FontSize="20"
                                       Symbol="{Binding LiveSymbol}"
                                       Visibility="{Binding IsMuted, Converter={StaticResource VisibleWhenFalse}}" />
                        <ui:SymbolIcon FontSize="20"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Symbol="{Binding MutedSymbol}"
                                       Visibility="{Binding IsMuted, Converter={StaticResource VisibleWhenTrue}}" />
                    </Grid>
                </ui:Button>

                <ui:TextBlock Grid.Column="2"
                              Margin="20,0,0,4"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              FontTypography="Caption"
                              Text="{Binding VolumeTitle}" />
                <StackPanel Grid.Row="1"
                            Grid.Column="2"
                            Margin="20,0,0,0"
                            IsEnabled="{Binding IsConnected}"
                            Orientation="Horizontal">
                    <Slider Width="150"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding VolumeTitle}"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding Volume}" />
                    <TextBlock Style="{StaticResource PercentLabel}" Text="{Binding Volume, StringFormat={}{0:0}%}" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <ui:InfoBar Title="{Binding DisconnectedTitle}"
                    Margin="0,4,0,0"
                    IsClosable="False"
                    IsOpen="{Binding IsDisconnected, Mode=OneWay}"
                    Message="It will reconnect automatically."
                    Severity="Warning" />
    </StackPanel>
</UserControl>
