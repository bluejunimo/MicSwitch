<ui:FluentWindow x:Class="MicSwitch.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:MicSwitch.UI.Pages"
                 x:ClassModifier="internal"
                 Title="MicSwitch"
                 Width="900"
                 Height="640"
                 MinWidth="560"
                 MinHeight="420"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar"
                     Title="MicSwitch"
                     Icon="{ui:SymbolIcon Mic24}" />

        <ui:NavigationView x:Name="Navigation"
                           Grid.Row="1"
                           Padding="32,8,32,0"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           OpenPaneLength="220"
                           PaneDisplayMode="Left">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Microphone"
                                       Icon="{ui:SymbolIcon Mic24}"
                                       TargetPageType="{x:Type pages:MicrophonePage}" />
                <ui:NavigationViewItem Content="Hotkeys"
                                       Icon="{ui:SymbolIcon Keyboard24}"
                                       TargetPageType="{x:Type pages:HotkeysPage}" />
                <ui:NavigationViewItem Content="Sounds"
                                       Icon="{ui:SymbolIcon Alert24}"
                                       TargetPageType="{x:Type pages:SoundsPage}" />
                <ui:NavigationViewItem Content="Overlay"
                                       Icon="{ui:SymbolIcon PictureInPicture24}"
                                       TargetPageType="{x:Type pages:OverlayPage}" />
                <ui:NavigationViewItem Content="Speakers"
                                       Icon="{ui:SymbolIcon Speaker224}"
                                       TargetPageType="{x:Type pages:SpeakersPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="General"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type pages:GeneralPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
