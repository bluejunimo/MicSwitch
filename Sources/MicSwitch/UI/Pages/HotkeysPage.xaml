<Page x:Class="MicSwitch.UI.Pages.HotkeysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      x:ClassModifier="internal"
      Title="Hotkeys">
    <StackPanel Margin="0,0,0,24">
        <ui:TextBlock Style="{StaticResource PageTitle}" Text="Hotkeys" />

        <ui:InfoBar Margin="0,0,0,8"
                    IsClosable="True"
                    IsOpen="{Binding IsNotElevated, Mode=OneTime}"
                    Message="Hotkeys don't work while an app running as administrator is focused. Run as administrator, under General, fixes that."
                    Severity="Informational" />

        <ui:CardControl Margin="0,0,0,4"
                        Header="Mode"
                        Icon="{ui:SymbolIcon Options24}">
            <ComboBox MinWidth="160"
                      AutomationProperties.Name="Mode"
                      DisplayMemberPath="Label"
                      ItemsSource="{Binding Modes}"
                      SelectedValue="{Binding Mode}"
                      SelectedValuePath="Value" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4"
                        Header="Hotkey"
                        Icon="{ui:SymbolIcon Keyboard24}">
            <ContentControl Content="{Binding Hotkey}"
                            ContentTemplate="{StaticResource HotkeyKeysTemplate}"
                            Focusable="False" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon LockClosed24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="Block from other apps" />
                    <ui:TextBlock Style="{StaticResource CardDescription}" Text="The app you're using doesn't see the hotkey." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="Block from other apps" IsChecked="{Binding Hotkey.Suppress}" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4"
                        Icon="{ui:SymbolIcon ArrowUp24}"
                        IsEnabled="{Binding Hotkey.CanIgnoreModifiers}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="Ignore modifiers" />
                    <ui:TextBlock Style="{StaticResource CardDescription}" Text="Works while Ctrl, Alt or Shift is held." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="Ignore modifiers" IsChecked="{Binding Hotkey.IgnoreModifiers}" />
        </ui:CardControl>

        <ui:CardExpander Margin="0,0,0,4"
                         ContentPadding="20,10"
                         Icon="{ui:SymbolIcon Add24}">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="Extra hotkeys" />
                        <ui:TextBlock Style="{StaticResource CardDescription}" Text="Separate keys for each action, whatever the mode." />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1"
                                     Margin="0,0,16,0"
                                     AutomationProperties.Name="Extra hotkeys"
                                     IsChecked="{Binding ExtraHotkeysEnabled}" />
                </Grid>
            </ui:CardExpander.Header>
            <ItemsControl Focusable="False"
                          IsEnabled="{Binding ExtraHotkeysEnabled}"
                          ItemTemplate="{StaticResource HotkeyRowTemplate}"
                          ItemsSource="{Binding ExtraHotkeys}" />
        </ui:CardExpander>
    </StackPanel>
</Page>
