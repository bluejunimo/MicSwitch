<Page x:Class="MicSwitch.UI.Pages.OverlayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      x:ClassModifier="internal"
      Title="Overlay">
    <StackPanel Margin="0,0,0,24">
        <ui:TextBlock Style="{StaticResource PageTitle}" Text="Overlay" />

        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Eye24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="Show overlay" />
                    <ui:TextBlock Style="{StaticResource CardDescription}" Text="A microphone icon that stays on top of other windows." />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox MinWidth="160"
                      AutomationProperties.Name="Show overlay"
                      DisplayMemberPath="Label"
                      ItemsSource="{Binding Visibilities}"
                      SelectedValue="{Binding Visibility}"
                      SelectedValuePath="Value" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4"
                        Header="Opacity"
                        Icon="{ui:SymbolIcon CircleHalfFill24}"
                        IsEnabled="{Binding IsShown}">
            <StackPanel Orientation="Horizontal">
                <Slider Width="220"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Overlay opacity"
                        Maximum="100"
                        Minimum="10"
                        Value="{Binding Opacity}" />
                <TextBlock Style="{StaticResource PercentLabel}" Text="{Binding Opacity, StringFormat={}{0:0}%}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4"
                        Icon="{ui:SymbolIcon ArrowMove24}"
                        IsEnabled="{Binding IsShown}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="Move and resize" />
                    <ui:TextBlock Style="{StaticResource CardDescription}" Text="Drag the overlay, or its corner to resize. Turn off when done." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="Move and resize" IsChecked="{Binding IsUnlocked}" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4"
                        Header="Position and size"
                        Icon="{ui:SymbolIcon ArrowReset24}"
                        IsEnabled="{Binding IsShown}">
            <ui:Button Command="{Binding ResetPositionCommand}" Content="Reset" />
        </ui:CardControl>

        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Icons" />

        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Image24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="Custom icons" />
                    <ui:TextBlock Style="{StaticResource CardDescription}" Text="Used by the overlay and the tray icon." />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button Padding="6"
                           AutomationProperties.Name="Icon when on"
                           Command="{Binding ChooseMicIconCommand}"
                           ToolTip="Icon when on">
                    <Image Width="28"
                           Height="28"
                           Source="{Binding MicIcon}" />
                </ui:Button>
                <ui:Button Margin="8,0,0,0"
                           Padding="6"
                           AutomationProperties.Name="Icon when muted"
                           Command="{Binding ChooseMutedIconCommand}"
                           ToolTip="Icon when muted">
                    <Image Width="28"
                           Height="28"
                           Source="{Binding MutedIcon}" />
                </ui:Button>
                <ui:Button Margin="8,0,0,0"
                           Command="{Binding ResetIconsCommand}"
                           Content="Reset"
                           IsEnabled="{Binding HasCustomIcons}" />
            </StackPanel>
        </ui:CardControl>
    </StackPanel>
</Page>
