<Page x:Class="MicSwitch.UI.Pages.SpeakersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      x:ClassModifier="internal"
      Title="Speakers">
    <StackPanel Margin="0,0,0,24">
        <ui:TextBlock Style="{StaticResource PageTitle}" Text="Speakers" />

        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Keyboard24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="Speaker hotkeys" />
                    <ui:TextBlock Style="{StaticResource CardDescription}" Text="Mute and change the volume of your speakers with hotkeys." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="Speaker hotkeys" IsChecked="{Binding IsEnabled}" />
        </ui:CardControl>

        <StackPanel IsEnabled="{Binding IsEnabled}">
            <ui:CardControl Margin="0,0,0,4"
                            Header="Device"
                            Icon="{ui:SymbolIcon Headphones24}">
                <ComboBox MinWidth="240"
                          MaxWidth="320"
                          AutomationProperties.Name="Speaker device"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4"
                            Header="Muted"
                            Icon="{ui:SymbolIcon SpeakerMute24}"
                            IsEnabled="{Binding IsConnected}">
                <ui:ToggleSwitch AutomationProperties.Name="Speakers muted" IsChecked="{Binding IsMuted}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4"
                            Header="Volume"
                            Icon="{ui:SymbolIcon Speaker224}"
                            IsEnabled="{Binding IsConnected}">
                <StackPanel Orientation="Horizontal">
                    <Slider Width="220"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Speaker volume"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding Volume}" />
                    <TextBlock Style="{StaticResource PercentLabel}" Text="{Binding Volume, StringFormat={}{0:0}%}" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardExpander Margin="0,0,0,4"
                             ContentPadding="20,10"
                             Header="Hotkeys"
                             Icon="{ui:SymbolIcon Keyboard24}"
                             IsExpanded="True">
                <ItemsControl Focusable="False"
                              ItemTemplate="{StaticResource HotkeyRowTemplate}"
                              ItemsSource="{Binding Hotkeys}" />
            </ui:CardExpander>
        </StackPanel>
    </StackPanel>
</Page>
