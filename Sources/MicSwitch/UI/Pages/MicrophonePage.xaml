<Page x:Class="MicSwitch.UI.Pages.MicrophonePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      x:ClassModifier="internal"
      Title="Microphone">
    <StackPanel Margin="0,0,0,24">
        <ui:TextBlock Style="{StaticResource PageTitle}" Text="Microphone" />

        <ui:InfoBar Title="{Binding DisconnectedTitle}"
                    Margin="0,0,0,8"
                    IsClosable="False"
                    IsOpen="{Binding IsDisconnected, Mode=OneWay}"
                    Message="It will reconnect automatically."
                    Severity="Warning" />

        <!-- The one setting that matters most: which microphone. -->
        <ui:Card Margin="0,0,0,4" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Width="40"
                      Margin="0,0,16,0"
                      VerticalAlignment="Center">
                    <ui:SymbolIcon FontSize="32"
                                   Symbol="Mic24"
                                   Visibility="{Binding IsMuted, Converter={StaticResource VisibleWhenFalse}}" />
                    <ui:SymbolIcon FontSize="32"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Symbol="MicOff24"
                                   Visibility="{Binding IsMuted, Converter={StaticResource VisibleWhenTrue}}" />
                </Grid>

                <ComboBox Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Microphone"
                          DisplayMemberPath="Label"
                          FontSize="16"
                          ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}" />

                <ProgressBar Grid.Row="1"
                             Grid.Column="1"
                             Height="4"
                             Margin="0,14,0,0"
                             AutomationProperties.Name="Input level"
                             Maximum="1"
                             Minimum="0"
                             Value="{Binding Level, Mode=OneWay}" />
            </Grid>
        </ui:Card>

        <ui:CardControl Margin="0,0,0,4"
                        Header="Muted"
                        Icon="{ui:SymbolIcon MicOff24}"
                        IsEnabled="{Binding IsConnected}">
            <ui:ToggleSwitch AutomationProperties.Name="Muted" IsChecked="{Binding IsMuted}" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4"
                        Header="Input volume"
                        Icon="{ui:SymbolIcon Speaker124}"
                        IsEnabled="{Binding IsConnected}">
            <StackPanel Orientation="Horizontal">
                <Slider Width="220"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Input volume"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding Volume}" />
                <TextBlock Style="{StaticResource PercentLabel}" Text="{Binding Volume, StringFormat={}{0:0}%}" />
            </StackPanel>
        </ui:CardControl>

        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="On startup" />

        <ui:CardControl Margin="0,0,0,4"
                        Icon="{ui:SymbolIcon Power24}"
                        IsEnabled="{Binding IsStartupStateEnabled}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="Mute state" />
                    <ui:TextBlock Style="{StaticResource CardDescription}" Text="Push-to-talk and push-to-mute set this themselves." />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox MinWidth="160"
                      DisplayMemberPath="Label"
                      ItemsSource="{Binding StartupStates}"
                      SelectedValue="{Binding StartupState}"
                      SelectedValuePath="Value" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4"
                        Header="Restore input volume"
                        Icon="{ui:SymbolIcon ArrowCounterclockwise24}">
            <ui:ToggleSwitch AutomationProperties.Name="Restore input volume" IsChecked="{Binding RestoreVolume}" />
        </ui:CardControl>
    </StackPanel>
</Page>
