<Application x:Class="MicSwitch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:MicSwitch.UI.Controls"
             xmlns:local="clr-namespace:MicSwitch.UI"
             xmlns:vm="clr-namespace:MicSwitch.UI.ViewModels"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="VisibleWhenTrue" />
            <local:BoolToVisibilityConverter x:Key="VisibleWhenFalse" Invert="True" />

            <Style TargetType="{x:Type controls:HotkeyBox}" BasedOn="{StaticResource {x:Type ui:TextBox}}">
                <Setter Property="Width" Value="150" />
            </Style>

            <Style x:Key="PageTitle" TargetType="{x:Type ui:TextBlock}">
                <Setter Property="FontTypography" Value="Title" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="{x:Type ui:TextBlock}">
                <Setter Property="FontTypography" Value="BodyStrong" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="0,24,0,8" />
            </Style>

            <Style x:Key="CardDescription" TargetType="{x:Type ui:TextBlock}">
                <Setter Property="FontTypography" Value="Caption" />
                <!-- Not Appearance="Secondary": that keeps the old colour when the theme is switched. -->
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="PercentLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="Width" Value="44" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- The two key boxes of a hotkey. -->
            <DataTemplate x:Key="HotkeyKeysTemplate" DataType="{x:Type vm:HotkeyEditorViewModel}">
                <StackPanel Orientation="Horizontal">
                    <controls:HotkeyBox AutomationProperties.Name="{Binding Label}" Gesture="{Binding Key}" />
                    <ui:TextBlock Margin="8,0"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="or" />
                    <controls:HotkeyBox AutomationProperties.Name="{Binding Label, StringFormat={}{0}\, alternative}" Gesture="{Binding AltKey}" />
                </StackPanel>
            </DataTemplate>

            <!-- A whole hotkey on one row of a list: name, keys and options. -->
            <DataTemplate x:Key="HotkeyRowTemplate" DataType="{x:Type vm:HotkeyEditorViewModel}">
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                    <ContentControl Grid.Column="1"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource HotkeyKeysTemplate}"
                                    Focusable="False" />
                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,4,0,0"
                                Orientation="Horizontal">
                        <CheckBox Content="Suppress in other apps" IsChecked="{Binding Suppress}" />
                        <CheckBox Margin="16,0,0,0"
                                  Content="Ignore modifiers"
                                  IsChecked="{Binding IgnoreModifiers}"
                                  IsEnabled="{Binding CanIgnoreModifiers}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
